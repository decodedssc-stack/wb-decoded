# ==============================================================================
# WB DECODED - FIREBASE AUTHENTICATION CONFIGURATION
# ==============================================================================
# Get these values from: https://console.firebase.google.com/
# 1. Create a free project -> Enable "Authentication"
# 2. Under Sign-in method, enable "Google" and "Phone"
# 3. Under Project Settings -> General -> Web Apps -> Copy the SDK config:

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDemoKeyReplaceWithYours
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wb-decoded.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wb-decoded
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wb-decoded.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Indian Carrier SMS Gateway Key (Fast2SMS / 2Factor)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
